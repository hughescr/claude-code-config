{
  "description": "Inject Craig's instructions: CLAUDE.md (unless already loaded natively) plus MAIN-CLAUDE.md at session start, CLAUDE.md plus SUBAGENT-CLAUDE.md at sub-agent start. One command per part keeps each under the 10,000-character context cap.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-instructions.sh\" SessionStart common",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-instructions.sh\" SessionStart role",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-instructions.sh\" SessionStart project",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-instructions.sh\" SubagentStart common",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-instructions.sh\" SubagentStart role",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-instructions.sh\" SubagentStart project",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
