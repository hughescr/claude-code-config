{
  "name": "craig-bluesky-tool",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "bun src/build.ts",
    "check:bundle": "bun src/build.ts --check",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit --strict --noUnusedLocals --noUnusedParameters --noImplicitReturns --noFallthroughCasesInSwitch --skipLibCheck --target ES2022 --module ESNext --moduleResolution bundler --types bun src/*.ts tests/*.ts"
  },
  "dependencies": { "@atproto/api": "0.24.0" },
  "devDependencies": { "@types/bun": "1.4.2", "typescript": "7.0.2" },
  "overrides": {
    "@atproto/common-web": "0.5.14",
    "@atproto/lex-data": "0.1.8",
    "@atproto/lex-json": "0.1.7",
    "@atproto/lexicon": "0.7.16",
    "@atproto/syntax": "0.7.6",
    "@atproto/xrpc": "0.8.15",
    "@types/node": "26.6.4",
    "await-lock": "3.0.0",
    "bun-types": "1.4.2",
    "iso-datestring-validator": "2.2.2",
    "multiformats": "13.4.2",
    "tlds": "1.261.0",
    "tslib": "2.8.1",
    "undici-types": "8.9.0",
    "unicode-segmenter": "0.14.5",
    "vscode-jsonrpc": "9.0.0",
    "zod": "3.25.76"
  }
}
