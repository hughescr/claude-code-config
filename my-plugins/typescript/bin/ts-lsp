#!/bin/sh
# ts-lsp: launch the TypeScript language server that matches the project.
#
# Usage: ts-lsp [--workspace DIR] [--explain]
#
#   (no flags)  resolve the server for the workspace and exec it over stdio.
#               Exits 3 with a one-line stderr message when no server works.
#   --explain   print the resolution as key=value lines and exit 0 without
#               exec. The SessionStart hook (hooks/ts-lsp-check.sh) calls this,
#               so what it reports is exactly what the launcher would run.
#
# The workspace is --workspace DIR, else $CLAUDE_PROJECT_DIR, else $PWD.
#
# What the project DECLARES decides; node_modules only supplies the binary for
# what is declared. The nearest ancestor package.json that declares a relevant
# dependency (typescript, an npm alias of typescript, @typescript/native-preview
# or tsrs, in dependencies, devDependencies, peerDependencies or
# optionalDependencies) decides, so a monorepo root that declares TypeScript
# decides for its sub-packages. Binaries in node_modules that no package.json
# declares (a stale tsgo build, say) are never used. The declared package is
# found Node-style: the nearest node_modules, from the declaring package.json's
# directory upward, that has it.
#
# Order of choice (the first that applies):
#   1. tsrs declared                  -> node_modules/.bin/tsrs --lsp --stdio
#   2. TypeScript 7+ declared         -> its tsc --lsp --stdio (TS 7 is the Go-native compiler).
#        "Declared" is `typescript` with a range whose major is >= 7 (dist-tags
#        such as latest and next count as 7), or ANY dependency whose value is
#        an npm alias of typescript 7+ (NAME: "npm:typescript@7.0.2", "^7",
#        "latest"). The binary is <node_modules>/NAME/bin/tsc (NAME may be
#        scoped, e.g. @typescript/native; for plain typescript it falls back to
#        .bin/tsc), and the installed package.json must report major >= 7.
#        This wins over a co-declared typescript < 7, which a project keeps for
#        tools that import the JS API. A range with no readable major
#        (catalog:, workspace:*) takes the installed version's major instead.
#   3. @typescript/native-preview declared -> node_modules/.bin/tsgo --lsp --stdio
#   4. only typescript < 7 declared (directly or via alias)
#                                     -> typescript-language-server --stdio, from
#                                        node_modules/.bin if present, else from PATH
#                                        (it uses the workspace's tsserver). This helper
#                                        is the one thing that need not be declared: it is
#                                        tooling, not the compiler. Needs the declared
#                                        typescript installed.
#   A declared choice that is not installed (no node_modules, binary absent,
#   wrong version) is matched=no with a hint to install the project's
#   dependencies; it does not fall through to a lower rule.
#   Nothing relevant declared: want=unknown.
#   Fallback (matched=no): tsrs on PATH, then tsc >= 7 on PATH, then tsgo on PATH.
#   Otherwise kind=none.
#
# Verified command (run against typescript 7.0.2, @typescript/native-preview
# 7.0.0-dev.20260707.2 and tsrs 0.25.0-ts7.1.0-beta): `<bin> --lsp --stdio`.
#
# POSIX sh. jq is used when present. Without jq, package.json is read by the
# shell itself (no process is spawned): the file is split at commas and braces
# and every piece of the exact form "key": "string" counts as a dependency entry. That reads one entry per
# line and minified files, and sees an entry anywhere in the file (a typescript
# pin under "overrides" counts as a declaration). It misreads values that
# contain a comma, brace or escaped quote, and it does not notice an
# unparsable package.json.

set -u
LC_ALL=C
export LC_ALL

explain=0
ws=

while [ $# -gt 0 ]; do
  case $1 in
    --explain) explain=1 ;;
    --workspace)
      shift
      if [ $# -eq 0 ]; then
        echo "ts-lsp: --workspace needs a directory" >&2
        exit 2
      fi
      ws=$1
      ;;
    *)
      echo "ts-lsp: unknown argument '$1' (usage: ts-lsp [--workspace DIR] [--explain])" >&2
      exit 2
      ;;
  esac
  shift
done

[ -n "$ws" ] || ws=${CLAUDE_PROJECT_DIR:-${PWD:-.}}
# Performance: this launcher runs at every session start, and every process it
# spawns costs a fork, so everything below that can be done by the shell itself
# (parameter expansion, case, [ ]) is. An absolute path with no ".", ".." or
# "//" part is already what `cd DIR && pwd` would print; anything else, or a
# directory that is missing or not searchable, goes through cd so the answer
# and the error stay the same.
ws_plain=0
case $ws in
  /*)
    case $ws in
      *//* | */./* | */../* | */. | */.. | */) ;;
      *) [ -d "$ws" ] && [ -x "$ws" ] && ws_plain=1 ;;
    esac
    ;;
esac
if [ "$ws_plain" = 0 ]; then
  ws_arg=$ws
  ws=$(cd "$ws" 2>/dev/null && pwd) || {
    echo "ts-lsp: workspace '$ws_arg' is not a directory" >&2
    exit 2
  }
fi

have_jq=0
command -v jq >/dev/null 2>&1 && have_jq=1

nl='
'
old_ifs=$IFS

# ---- package.json readers ---------------------------------------------------

# The readers set a variable instead of printing, so the no-jq path (which is
# pure shell) needs no process at all and the jq path needs exactly one.

# Set RV to the "version" of a package.json (empty when unreadable or unparsable).
read_version() {
  RV=
  [ -f "$1" ] || return 0
  if [ "$have_jq" = 1 ]; then
    RV=$(jq -r 'if (.version | type) == "string" then .version else empty end' "$1" 2>/dev/null)
  else
    nojq_version "$1"
  fi
}

# Set ALL to every string-valued dependency entry of package.json $1 as "name
# value" lines, across dependencies, devDependencies, peerDependencies and
# optionalDependencies (see the header comment for the no-jq limits).
list_decls() {
  ALL=
  [ -f "$1" ] || return 0
  if [ "$have_jq" = 1 ]; then
    ALL=$(jq -r '[.dependencies, .devDependencies, .peerDependencies, .optionalDependencies]
      | map(select(type == "object") | to_entries[] | select(.value | type == "string"))
      | .[] | "\(.key) \(.value)"' "$1" 2>/dev/null)
  else
    nojq_decls "$1"
  fi
}

# ---- the no-jq readers: what the sed/tr pipeline did, in the shell itself -----

# Set RV to the "version" of the first line that has a `"version": "STRING"`
# pair (the last such pair on that line, as a greedy `.*"version"` finds it).
nojq_version() {
  [ -r "$1" ] || return 0
  while IFS= read -r _line || [ -n "$_line" ]; do
    _rest=$_line
    _found=0
    while :; do
      case $_rest in *'"version"'*) ;; *) break ;; esac
      _after=${_rest#*'"version"'}
      _rest=\"$_after # an occurrence may start at the quote that just closed this one
      _t=${_after#"${_after%%[![:space:]]*}"}
      case $_t in :*) ;; *) continue ;; esac
      _t=${_t#:}
      _t=${_t#"${_t%%[![:space:]]*}"}
      case $_t in \"*) ;; *) continue ;; esac
      _t=${_t#\"}
      case $_t in *\"*) ;; *) continue ;; esac
      RV=${_t%%\"*}
      _found=1
    done
    [ "$_found" = 0 ] || break
  done 2>/dev/null <"$1"
}

# Set ALL from package.json $1 without jq. The file is split at commas, braces
# and carriage returns (and so at newlines), and every piece of exactly the
# form  "key": "string"  (blanks allowed around the parts) is an entry.
nojq_decls() {
  [ -r "$1" ] || return 0
  [ -n "${cr:-}" ] || cr=$(printf '\r')
  _sep="[,{}$cr]"
  while IFS= read -r _line || [ -n "$_line" ]; do
    _rest=$_line
    _more=1
    while [ "$_more" = 1 ]; do
      # $_sep is a glob pattern on purpose.
      # shellcheck disable=SC2295
      case $_rest in
        *$_sep*)
          _piece=${_rest%%$_sep*}
          _rest=${_rest#*$_sep}
          ;;
        *)
          _piece=$_rest
          _more=0
          ;;
      esac
      _t=${_piece#"${_piece%%[![:space:]]*}"}
      case $_t in \"*) ;; *) continue ;; esac
      _t=${_t#\"}
      case $_t in *\"*) ;; *) continue ;; esac
      _k=${_t%%\"*}
      _t=${_t#*\"}
      _t=${_t#"${_t%%[![:space:]]*}"}
      case $_t in :*) ;; *) continue ;; esac
      _t=${_t#:}
      _t=${_t#"${_t%%[![:space:]]*}"}
      case $_t in \"*) ;; *) continue ;; esac
      _t=${_t#\"}
      case $_t in *\"*) ;; *) continue ;; esac
      _v=${_t%%\"*}
      _t=${_t#*\"}
      case $_t in *[![:space:]]*) continue ;; esac
      ALL=$ALL$_k\ $_v$nl
    done
  done 2>/dev/null <"$1"
}

# True for a dependency entry that matters here: typescript, an npm alias of it
# ("npm:typescript" or "npm:typescript@RANGE"), @typescript/native-preview, tsrs.
is_relevant() { # name value
  case $1 in typescript | @typescript/native-preview | tsrs) return 0 ;; esac
  case $2 in npm:typescript | npm:typescript@*) return 0 ;; esac
  return 1
}

# Set MAJOR to the leading integer of a version or range ("^5.4" -> 5,
# "npm:typescript@6" -> 6; empty when there is none). Pure parameter expansion:
# no subshell, so callers read $MAJOR instead of capturing output.
major_of() {
  _pre=${1%%[0-9]*}
  _rest=${1#"$_pre"}
  MAJOR=${_rest%%[!0-9]*}
}

# Like major_of, with dist-tags mapped to the current major (7); sets RMAJOR.
range_major() {
  case $1 in
    latest | next | beta | rc | dev | insiders | '*' | x | X) RMAJOR=7 ;;
    *)
      major_of "$1"
      RMAJOR=$MAJOR
      ;;
  esac
}

# ---- find the deciding package.json -----------------------------------------

decl_pkg=
decl_dir=$ws
decl_tsrs=
decl_native=
ts_decls=
notes=

d=$ws
while :; do
  if [ -f "$d/package.json" ]; then
    rel=
    list_decls "$d/package.json"
    all=$ALL
    # Lines are walked with IFS=newline, not a here-document (ksh writes those to a temp file).
    set -f
    IFS=$nl
    for line in $all; do
      dn=${line%% *}
      dv=${line#* }
      [ -n "$dn" ] && [ -n "$dv" ] && [ "$dn" != "$line" ] || continue
      is_relevant "$dn" "$dv" || continue
      rel="$rel$dn $dv$nl"
    done
    IFS=$old_ifs
    set +f
    if [ -n "$rel" ]; then
      decl_pkg=$d/package.json
      decl_dir=$d
      set -f
      IFS=$nl
      for line in $rel; do
        dn=${line%% *}
        dv=${line#* }
        case $dn in
          tsrs) [ -n "$decl_tsrs" ] || decl_tsrs=$dv ;;
          @typescript/native-preview) [ -n "$decl_native" ] || decl_native=$dv ;;
        esac
        case $dn:$dv in
          tsrs:* | @typescript/native-preview:*) ;;
          *) ts_decls="$ts_decls$dn $dv$nl" ;;
        esac
      done
      IFS=$old_ifs
      set +f
      break
    elif [ "$have_jq" = 1 ] && ! jq -e . "$d/package.json" >/dev/null 2>&1; then
      [ -n "$notes" ] || notes="ignored unparsable $d/package.json"
    fi
  fi
  [ "$d" = / ] && break
  parent=${d%/*}
  [ -n "$parent" ] || parent=/
  d=$parent
done

# ---- node_modules lookups, Node-style, from the declaring package.json's dir --

# Set NM to the nearest node_modules directory that holds package $1 (status 1
# when none does). These helpers set a variable instead of printing, so callers
# need no command substitution (a subshell each).
nearest_nm() {
  _d=$decl_dir
  while :; do
    if [ -f "$_d/node_modules/$1/package.json" ]; then
      NM=$_d/node_modules
      return 0
    fi
    [ "$_d" = / ] && return 1
    _p=${_d%/*}
    [ -n "$_p" ] || _p=/
    _d=$_p
  done
}

# Set NB to the nearest executable node_modules/.bin/$1 (status 1 when none).
nearest_bin() {
  _d=$decl_dir
  while :; do
    if [ -f "$_d/node_modules/.bin/$1" ] && [ -x "$_d/node_modules/.bin/$1" ]; then
      NB=$_d/node_modules/.bin/$1
      return 0
    fi
    [ "$_d" = / ] && return 1
    _p=${_d%/*}
    [ -n "$_p" ] || _p=/
    _d=$_p
  done
}

# Set FP to the first regular executable file named $1 on PATH, as
# `command -v` would find it ("" when none). A relative result (an empty or
# relative PATH entry) is returned as such; callers only accept absolute ones.
find_in_path() {
  FP=
  if [ -z "${PATH:-}" ]; then
    FP=$(command -v "$1" 2>/dev/null) || FP=
    return 0
  fi
  _rest=$PATH
  _more=1
  while [ "$_more" = 1 ]; do
    case $_rest in
      *:*)
        _dir=${_rest%%:*}
        _rest=${_rest#*:}
        ;;
      *)
        _dir=$_rest
        _more=0
        ;;
    esac
    [ -n "$_dir" ] || _dir=.
    if [ -x "$_dir/$1" ] && [ ! -d "$_dir/$1" ]; then
      FP=$_dir/$1
      return 0
    fi
  done
  return 0
}

is_exec() { [ -f "$1" ] && [ -x "$1" ]; }

# ---- decide -----------------------------------------------------------------

kind=none
matched=no
want=unknown
cmd=
reason=
hint=

install_hint="install the project's dependencies (npm install, bun install or pnpm install)"

pick_project() {
  if [ -z "$decl_pkg" ]; then
    want=unknown
    reason="no package.json at or above $ws declares typescript, @typescript/native-preview or tsrs"
    hint="npm install -D typescript@7 (TypeScript 7 has a built-in language server), or tsrs"
    return 1
  fi

  # 1. tsrs
  if [ -n "$decl_tsrs" ]; then
    want=tsrs
    if nearest_bin tsrs; then
      b=$NB
      kind=tsrs-project matched=yes cmd=$b
      reason="$decl_pkg declares tsrs = $decl_tsrs; using $b"
      return 0
    fi
    reason="$decl_pkg declares tsrs = $decl_tsrs but node_modules/.bin/tsrs is not installed"
    hint=$install_hint
    return 1
  fi

  # Classify the typescript declarations (plain and aliased) by effective major.
  t7_label=
  t7_why=
  t7_bin=
  t7_ok=
  old_label=
  old_inst=
  old_iv=
  set -f
  IFS=$nl
  for line in $ts_decls; do
    dn=${line%% *}
    dv=${line#* }
    spec=$dv
    case $dv in
      npm:typescript@*) spec=${dv#npm:typescript@} ;;
      npm:typescript) spec=latest ;;
    esac
    range_major "$spec"
    rmaj=$RMAJOR
    nm=
    iv=
    im=
    if nearest_nm "$dn"; then
      nm=$NM
      read_version "$nm/$dn/package.json"
      iv=$RV
      major_of "$iv"
      im=$MAJOR
      [ -n "$iv" ] || [ -n "$notes" ] || notes="ignored unreadable $nm/$dn/package.json"
    fi
    em=${rmaj:-$im}
    em=${em:-0}
    if [ "$em" -ge 7 ]; then
      [ -n "$t7_label" ] || t7_label="$dn = $dv"
      [ -z "$t7_bin" ] || continue
      if [ -z "$nm" ]; then
        [ -n "$t7_why" ] || t7_why="$dn is not installed"
      elif [ -z "$im" ] || [ "$im" -lt 7 ]; then
        [ -n "$t7_why" ] || t7_why="installed $dn in $nm is ${iv:-of unknown version}, not TypeScript 7"
      elif is_exec "$nm/$dn/bin/tsc"; then
        t7_bin=$nm/$dn/bin/tsc t7_ok="$dn = $dv"
      elif [ "$dn" = typescript ] && is_exec "$nm/.bin/tsc"; then
        t7_bin=$nm/.bin/tsc t7_ok="$dn = $dv"
      else
        [ -n "$t7_why" ] || t7_why="installed $dn $iv has no tsc binary"
      fi
    else
      [ -n "$old_label" ] || old_label="$dn = $dv"
      if [ -n "$nm" ] && [ -z "$old_inst" ]; then
        old_inst="$dn = $dv"
        old_iv=$iv
      fi
    fi
  done
  IFS=$old_ifs
  set +f

  # 2. TypeScript 7+
  if [ -n "$t7_label" ]; then
    want=ts7
    if [ -n "$t7_bin" ]; then
      kind=tsc7-project matched=yes cmd=$t7_bin
      reason="$decl_pkg declares $t7_ok; using $t7_bin"
      return 0
    fi
    reason="$decl_pkg declares $t7_label (TypeScript 7) but $t7_why"
    hint=$install_hint
    return 1
  fi

  # 3. @typescript/native-preview
  if [ -n "$decl_native" ]; then
    want=ts7
    if nearest_bin tsgo; then
      b=$NB
      kind=tsgo-project matched=yes cmd=$b
      reason="$decl_pkg declares @typescript/native-preview = $decl_native; using $b"
      return 0
    fi
    reason="$decl_pkg declares @typescript/native-preview = $decl_native but node_modules/.bin/tsgo is not installed"
    hint=$install_hint
    return 1
  fi

  # 4. only typescript < 7: typescript-language-server (the one undeclared helper)
  want=classic
  if [ -z "$old_inst" ]; then
    reason="$decl_pkg declares $old_label but it is not installed"
    hint="$install_hint, plus typescript-language-server (npm install -D typescript-language-server)"
    return 1
  fi
  if nearest_bin typescript-language-server; then
    b=$NB
    kind=tsls-project matched=yes cmd=$b
    reason="$decl_pkg declares $old_inst (installed ${old_iv:-version unknown}); using project typescript-language-server at $b"
    return 0
  fi
  find_in_path typescript-language-server
  case $FP in
    /*)
      p=$FP
      kind=tsls-path matched=yes cmd=$p
      reason="$decl_pkg declares $old_inst (installed ${old_iv:-version unknown}); using typescript-language-server on PATH at $p (it uses the workspace's tsserver)"
      return 0
      ;;
  esac
  reason="$decl_pkg declares $old_inst (installed ${old_iv:-version unknown}) but there is no typescript-language-server in the project or on PATH"
  hint="npm install -D typescript-language-server (or install it globally); to move to the Go-native server instead: npm install -D typescript@7"
  return 1
}

# A global (PATH) server: tsrs, then tsc >= 7, then tsgo.
pick_fallback() {
  find_in_path tsrs
  p=$FP
  case $p in
    /*)
      if "$p" --version >/dev/null 2>&1 </dev/null; then
        kind=tsrs-path cmd=$p
        fb="tsrs on PATH at $p"
        return 0
      fi
      ;;
  esac
  find_in_path tsc
  p=$FP
  case $p in
    /*)
      v=$("$p" --version 2>/dev/null </dev/null)
      v=${v%%"$nl"*} # the first line only
      major_of "$v"
      m=$MAJOR
      if [ -n "$m" ] && [ "$m" -ge 7 ]; then
        kind=tsc7-path cmd=$p
        fb="tsc $m on PATH at $p"
        return 0
      fi
      ;;
  esac
  find_in_path tsgo
  p=$FP
  case $p in
    /*)
      if "$p" --version >/dev/null 2>&1 </dev/null; then
        kind=tsgo-path cmd=$p
        fb="tsgo on PATH at $p"
        return 0
      fi
      ;;
  esac
  return 1
}

if ! pick_project; then
  fb=
  if pick_fallback; then
    reason="$reason; falling back to $fb"
  else
    kind=none
    cmd=
    reason="$reason; no tsrs, tsc >= 7 or tsgo on PATH either"
  fi
fi

# Binaries in node_modules that no package.json declares are never used; say so.
stray=
if [ -z "$decl_tsrs" ] && nearest_bin tsrs; then
  stray="ignored undeclared tsrs at $NB"
fi
if [ -z "$decl_native" ] && nearest_bin tsgo; then
  stray="${stray:+$stray, }ignored undeclared tsgo at $NB"
fi
[ -z "$stray" ] || notes="${notes:+$notes; }$stray"
[ -z "$notes" ] || reason="$reason ($notes)"

# typescript-language-server takes --stdio; the Go and Rust servers take --lsp --stdio.
case $kind in
  tsls-project | tsls-path) args=--stdio ;;
  *) args="--lsp --stdio" ;;
esac

# Values stay on one line: newline and carriage return become spaces. Values
# with no control character (all of them in practice) pass through untouched;
# only a value that has one pays for tr. Sets OL.
oneline() {
  case $1 in
    *[[:cntrl:]]*) OL=$(printf '%s' "$1" | tr '\n\r' '  ') ;;
    *) OL=$1 ;;
  esac
}

oneline "$ws"
ws_line=$OL
oneline "$reason"
reason_line=$OL
oneline "$hint"
hint_line=$OL

if [ "$explain" = 1 ]; then
  if [ -n "$cmd" ]; then
    oneline "$cmd"
    cmd_line="$OL $args"
  else
    cmd_line=
  fi
  printf 'kind=%s\nmatched=%s\nwant=%s\nworkspace=%s\ncommand=%s\nreason=%s\nhint=%s\n' \
    "$kind" "$matched" "$want" "$ws_line" "$cmd_line" "$reason_line" "$hint_line"
  exit 0
fi

if [ "$kind" = none ]; then
  echo "ts-lsp: no TypeScript language server for $ws_line: $reason_line. Install: $hint_line" >&2
  exit 3
fi

if [ "$matched" = no ]; then
  echo "ts-lsp: fallback $kind ($reason_line)" >&2
fi

# $args is deliberately unquoted: it is a fixed, space-separated flag list.
# shellcheck disable=SC2086
exec "$cmd" $args
