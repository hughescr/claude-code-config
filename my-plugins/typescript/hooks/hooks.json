{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/ts-lsp-check.sh\"",
            "timeout": 5,
            "statusMessage": "Checking the TypeScript language server"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/block-tsc-with-files.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
