{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "mcp__calculator",
      "mcp__documentation",
      "mcp__search",
      "mcp__time",
      "mcp__web-fetch"
    ],
    "deny": [
      "Edit",
      "WebFetch",
