{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash(bun -p 'crypto.randomUUID()')"
    ],
    "deny": [],
    "defaultMode": "plan"
  },
  "model": "opusplan",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'msg=$(jq -er \".message\" 2>/dev/null || { echo \"Invalid notification JSON\" >&2; exit 1; }); ntfy publish --priority high --title \"Claude Code\" --tag robot --tag claude_code 0oaXqomqjk3J5950 \"$msg\"'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/craig/.claude/count_tokens.js"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bunx --bun ccusage@latest statusline --visual-burn-rate emoji-text --no-offline",
    "padding": 0
  },
  "alwaysThinkingEnabled": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754119602031
  }
}
