{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "mcp__calculator",
      "mcp__documentation",
      "mcp__search",
      "mcp__time",
      "mcp__web-fetch"
    ],
    "deny": [
      "WebFetch",
      "WebSearch"
    ],
    "defaultMode": "plan"
  },
  "model": "opusplan",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'msg=$(jq -er \".message\" 2>/dev/null || { echo \"Invalid notification JSON\" >&2; exit 1; }); ntfy publish --priority high --title \"Claude Code\" --tag robot --tag claude_code 0oaXqomqjk3J5950 \"$msg\"'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/craig/.claude/count_tokens.js"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bunx --bun ccusage@latest statusline"
  },
  "feedbackSurveyState": {
    "lastShownTime": 1754119602031
  }
}
