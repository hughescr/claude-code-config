{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 365,
  "env": {},
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(tree:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Read(//tmp/claude/**)",
      "Edit(//tmp/claude/**)",
      "Read(//private/tmp/claude-*/**)",
      "Edit(//private/tmp/claude-*/**)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/git-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/approve-plugin-skills.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/inject-main-context.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/inject-subagent-context.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "bunx -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "ast-grep@ast-grep-marketplace": true,
    "clangd-lsp@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "claude-code-wakatime@wakatime": true,
    "claude-md-management@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "learning-opportunities@learning-opportunities": true,
    "pyright-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "shortcuts-playground@shortcuts-playground": false,
    "skill-development@oaustegard-claude-skills": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "typesafe@typesafe-ai": true
  },
  "extraKnownMarketplaces": {
    "craigs-claude-plugins": {
      "source": {
        "source": "directory",
        "path": "/Users/craig/.claude"
      }
    },
    "ast-grep-marketplace": {
      "source": {
        "source": "github",
        "repo": "ast-grep/agent-skill"
      },
      "autoUpdate": true
    },
    "learning-opportunities": {
      "source": {
        "source": "git",
        "url": "https://github.com/DrCatHicks/learning-opportunities.git"
      }
    },
    "oaustegard-claude-skills": {
      "source": {
        "source": "github",
        "repo": "oaustegard/claude-skills"
      }
    },
    "shortcuts-playground": {
      "source": {
        "source": "git",
        "url": "https://github.com/viticci/shortcuts-playground-plugin.git"
      }
    },
    "wakatime": {
      "source": {
        "source": "github",
        "repo": "wakatime/claude-code-wakatime"
      }
    },
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowAllUnixSockets": true,
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "~/Library/Caches/Mozilla.sccache"
      ]
    }
  },
  "alwaysThinkingEnabled": true,
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    }
  },
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "pluginConfigs": {
    "shortcuts-playground@shortcuts-playground": {
      "options": {
        "output_dir": "~/Desktop"
      }
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "preferredNotifChannel": "auto",
  "teammateMode": "auto",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": true,
  "autoMode": {
    "soft_deny": [
      "Bash(git push:*)",
      "Bash(git flow release finish:*)",
      "Bash(git tag:*)"
    ],
    "environment": [
      "Cutting a release, pushing to any git remote, and creating version tags are outward-facing, hard-to-reverse actions — they can publish code, trigger CI/CD, or upload builds to app stores (e.g. App Store Connect). Never run these without the user's explicit, in-the-moment authorization, even in auto mode. Knowing the release steps is not authorization to execute them."
    ]
  },
  "voiceEnabled": false,
  "_disabledHooks": {
    "_note": "Disabled 2026-07-28: preserving transcript/task history as calibration data for the token-estimation project. To re-enable, move SessionEnd back under hooks and remove cleanupPeriodDays override.",
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/cleanup-old-files.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "feedbackSurveyState": {
    "lastShownTime": 1754119602031
  }
}
