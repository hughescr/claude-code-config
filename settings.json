{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(cat:*)",
      "Bash(tree:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(curl:*)",
      "Read(//tmp/claude/**)",
      "Edit(//tmp/claude/**)",
      "Bash(mktemp /tmp/claude/codex-query.XXXXXX)",
      "Bash(~/.claude/scripts/codex/codex-start.sh *)",
      "Bash(~/.claude/scripts/codex/codex-wait.sh *)",
      "Bash(~/.claude/scripts/codex/codex-get-session-id.sh *)"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/block-temp-planning-files.sh",
            "if": "Bash(*<<*)",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/approve-plugin-skills.sh",
            "timeout": 5000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.claude/hooks/cleanup-old-files.sh",
            "timeout": 30000
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bunx -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "ast-grep@ast-grep-marketplace": true,
    "clangd-lsp@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "claude-code-wakatime@wakatime": true,
    "claude-md-management@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "shortcuts-playground@shortcuts-playground": true
  },
  "extraKnownMarketplaces": {
    "ast-grep-marketplace": {
      "source": {
        "source": "github",
        "repo": "ast-grep/agent-skill"
      },
      "autoUpdate": true
    },
    "wakatime": {
      "source": {
        "source": "github",
        "repo": "wakatime/claude-code-wakatime"
      }
    },
    "shortcuts-playground": {
      "source": {
        "source": "git",
        "url": "https://github.com/viticci/shortcuts-playground-plugin.git"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowAllUnixSockets": true,
      "allowLocalBinding": true
    }
  },
  "alwaysThinkingEnabled": true,
  "awaySummaryEnabled": false,
  "pluginConfigs": {
    "shortcuts-playground@shortcuts-playground": {
      "options": {
        "output_dir": "~/Desktop"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": true,
  "voiceEnabled": false,
  "feedbackSurveyState": {
    "lastShownTime": 1754119602031
  },
  "skipWorkflowUsageWarning": true
}
